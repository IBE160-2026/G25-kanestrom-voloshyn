# Copy this file to .env and fill in the values. Never commit .env.
# Empty values count as unset.

# --- App ---
# development (default) or production.
APP_ENV=
# Address the phone QR code encodes. Locally http://localhost:8000; for a phone demo use the computer's LAN address, e.g. http://192.168.1.20:8000
APP_PUBLIC_URL=
# Optional: seconds a phone upload link works (default 600, about 10 minutes).
PHONE_LINK_TTL_SECONDS=
# Optional: where the built SPA lives. Defaults to frontend/dist in the repo (/app/frontend/dist in the image).
FRONTEND_DIST=

# --- LLM (OpenRouter) ---
# mock or live. In development, unset with no key means mock. Production requires it to be set.
LLM_MODE=
# Only needed for LLM_MODE=live. Not needed to run the app or the tests.
OPENROUTER_API_KEY=
# OpenRouter model id for text tasks (naming, Topics, ...). Required for LLM_MODE=live; must support structured output with zdr.
LLM_TEXT_MODEL=
# OpenRouter model id for reading photos of notes (image input). Required for LLM_MODE=live; must support image input and structured output with zdr.
LLM_VISION_MODEL=
# Optional: seconds before a provider request gives up (default 60).
LLM_TIMEOUT_SECONDS=
# Optional: milliseconds every mock task waits (default 0).
LLM_MOCK_DELAY_MS=
# Optional: estimated tokens of material per request before a task is chunked (default 100000).
LLM_CONTEXT_BUDGET_TOKENS=
# Optional: words of material per Quiz question when estimating how many questions a scope supports (default 80).
CAPACITY_WORDS_PER_ITEM=

# --- Database (direct Postgres URL) ---
# Optional locally: defaults to postgresql://postgres:postgres@127.0.0.1:54322/postgres.
# docker-compose.yml sets the container's own value (host.docker.internal), so keep host values here.
DATABASE_URL=

# --- Supabase ---
# Server-to-server URL. Optional locally: defaults to http://127.0.0.1:54321.
# docker-compose.yml sets the container's own value (http://host.docker.internal:54321).
SUPABASE_URL=
# URL the browser uses. Optional locally: defaults to http://127.0.0.1:54321.
# To sign in from a phone or another device on the LAN, use the computer's LAN address, e.g. http://192.168.1.20:54321 (README › Mobil på lokalnettet).
SUPABASE_PUBLIC_URL=
# Keys printed by `npx supabase start` (shown again by `npx supabase status`).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Sessions ---
# Optional: days a session lasts after sign-in (default 30, FR-2).
SESSION_MAX_AGE_DAYS=

# --- Background jobs and Content Integrity (optional; the defaults follow the architecture) ---
# Jobs that run at once (default 3).
JOBS_MAX_CONCURRENT=
# Characters a page or slide needs to count as readable (default 20).
INTEGRITY_MIN_PAGE_CHARS=
# PDF and .pptx: accept at this share of readable pages or more (default 0.8), reject below the second (default 0.3).
INTEGRITY_PAGED_ACCEPT_RATIO=
INTEGRITY_PAGED_REJECT_RATIO=
# Any file with fewer characters in total is rejected (default 200).
INTEGRITY_MIN_TOTAL_CHARS=
# .docx, .txt, .md: accept without a warning at this many characters or more (default 1000).
INTEGRITY_TEXT_ACCEPT_CHARS=
# Images: fewer characters of extracted text than this rejects the photo (default 50).
INTEGRITY_MIN_IMAGE_CHARS=

# --- Daily limits ---
# Optional: IANA time zone whose calendar day the daily limits count (default Europe/Oslo).
QUOTA_TIMEZONE=

# --- Email (SMTP for verification and other auth emails) ---
# Optional locally: the defaults send to Mailpit from `npx supabase start` (SMTP 127.0.0.1:54325, web UI http://localhost:54324).
# docker-compose.yml sets the container's own host (host.docker.internal).
SMTP_HOST=
# Default 54325 (Mailpit).
SMTP_PORT=
# Default: Study Buddy <no-reply@studybuddy.local>
SMTP_FROM=
# Only for a real SMTP provider.
SMTP_USERNAME=
SMTP_PASSWORD=
# none (default, Mailpit), starttls, or tls.
SMTP_TLS=

# --- Google sign-in (optional; hidden unless all three are set) ---
# true or false. Must not be empty: supabase/config.toml reads it as a boolean, and the CLI fails on an empty value.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
