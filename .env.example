# Copy this file to .env and fill in the values. Never commit .env.
# Empty values count as unset.

# --- App ---
# development (default) or production.
APP_ENV=
# Address the phone QR code encodes. Locally http://localhost:8000; for a phone demo use the computer's LAN address, e.g. http://192.168.1.20:8000
APP_PUBLIC_URL=
# Optional: where the built SPA lives. Defaults to frontend/dist in the repo (/app/frontend/dist in the image).
FRONTEND_DIST=

# --- LLM (OpenRouter) ---
# mock or live. In development, unset with no key means mock. Production requires it to be set.
LLM_MODE=
# Only needed for LLM_MODE=live. Not needed to run the app or the tests.
OPENROUTER_API_KEY=

# --- Database (direct Postgres URL) ---
# Optional locally: defaults to postgresql://postgres:postgres@127.0.0.1:54322/postgres.
# docker-compose.yml sets the container's own value (host.docker.internal), so keep host values here.
DATABASE_URL=

# --- Supabase ---
# Server-to-server URL. Optional locally: defaults to http://127.0.0.1:54321.
# docker-compose.yml sets the container's own value (http://host.docker.internal:54321).
SUPABASE_URL=
# URL the browser uses. Optional locally: defaults to http://127.0.0.1:54321.
SUPABASE_PUBLIC_URL=
# Keys printed by `npx supabase start` (shown again by `npx supabase status`).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Google sign-in (optional; hidden unless all three are set) ---
# true or false. Must not be empty: supabase/config.toml reads it as a boolean, and the CLI fails on an empty value.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
